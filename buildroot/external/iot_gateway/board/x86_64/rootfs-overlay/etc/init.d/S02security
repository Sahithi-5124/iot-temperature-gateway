#!/bin/sh

case "$1" in
    start)
        echo 1 > /proc/sys/kernel/dmesg_restrict
        echo 2 > /proc/sys/kernel/kptr_restrict
        echo 1 > /proc/sys/net/ipv4/tcp_syncookies
        if [ -f /etc/iot-gateway/mqtt.env ]; then
            chmod 0600 /etc/iot-gateway/mqtt.env
            chown root:root /etc/iot-gateway/mqtt.env
        fi
        echo "Kernel and filesystem security settings applied."
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit 0
