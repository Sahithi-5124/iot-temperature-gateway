# Runtime configuration template for IoT Temperature Gateway
# Copy this file to /etc/iot-gateway/mqtt.env and restrict permissions:
#   chmod 0600 /etc/iot-gateway/mqtt.env
#   chown root:root /etc/iot-gateway/mqtt.env

MQTT_BROKER_HOST=10.0.2.2
MQTT_BROKER_PORT=1883
MQTT_USERNAME=gateway_pub
MQTT_PASSWORD=CHANGE_ME_IN_DEPLOYMENT
IOT_LOG_FILE=/root/temperature_log.csv
IOT_SENSOR_MODE=deterministic
